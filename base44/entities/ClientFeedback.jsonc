{
  "name": "ClientFeedback",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the client leaving the note"
    },
    "email": {
      "type": "string",
      "description": "Where the desk replies"
    },
    "company": {
      "type": "string"
    },
    "topic": {
      "type": "string",
      "enum": [
        "feedback",
        "bug",
        "question"
      ],
      "enumColors": [
        "blue",
        "red",
        "yellow"
      ],
      "default": "feedback"
    },
    "message": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "done"
      ],
      "enumColors": [
        "yellow",
        "green"
      ],
      "default": "new"
    }
  },
  "required": [
    "name",
    "message"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}