{
  "name": "Post",
  "type": "object",
  "properties": {
    "research_id": {
      "type": "string",
      "description": "The research run this post belongs to"
    },
    "platform": {
      "type": "string",
      "enum": [
        "reddit",
        "x",
        "youtube"
      ]
    },
    "rank": {
      "type": "number",
      "description": "Position in the ranked top 20"
    },
    "title": {
      "type": "string"
    },
    "excerpt": {
      "type": "string",
      "description": "Body or comment text from the post"
    },
    "author": {
      "type": "string"
    },
    "community": {
      "type": "string",
      "description": "Subreddit, channel or handle"
    },
    "url": {
      "type": "string"
    },
    "engagement": {
      "type": "number",
      "description": "Likes or upvotes"
    },
    "shares": {
      "type": "number",
      "description": "Reposts or shares where the platform reports them"
    },
    "comments": {
      "type": "number"
    },
    "views": {
      "type": "number"
    },
    "published_at": {
      "type": "string",
      "description": "ISO timestamp of the original post"
    },
    "trend": {
      "type": "string",
      "enum": [
        "rising",
        "steady",
        "cooling"
      ],
      "enumColors": [
        "green",
        "gray",
        "red"
      ],
      "description": "Engagement velocity compared with the rest of the run"
    },
    "sentiment": {
      "type": "string",
      "enum": [
        "positive",
        "neutral",
        "negative"
      ],
      "enumColors": [
        "green",
        "gray",
        "red"
      ]
    },
    "sentiment_score": {
      "type": "number"
    },
    "sentiment_reason": {
      "type": "string"
    }
  },
  "required": [
    "research_id",
    "platform",
    "title"
  ]
}